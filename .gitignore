# Devil ERP — Git Ignore
# Developed by Devil One Pvt Ltd & Nexuzy Lab

# Environment
.env
*.env

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
*.egg

# Database (local data)
database/*.db
database/*.sqlite
database/*.sqlite3

# AI Models (large files)
models/*.gguf
models/*.bin
models/*.safetensors
models/.initialized

# Google Drive credentials
credentials.json
token.json
*.pickle

# Firebase
firebasekey.json
serviceAccountKey.json

# PyInstaller
build/
dist/
*.spec.bak

# IDE
.vscode/
.idea/
*.sublime-*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Backups
backups/
*.bak

# Assets (don't ignore actual logo/icon)
!assets/logo.jpg
!assets/icon.ico
!assets/logo.png
