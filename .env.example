# Devil ERP — Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to GitHub!

# ============================================================
# Firebase Authentication
# ============================================================
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=yourproject.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=yourproject.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_DATABASE_URL=https://yourproject-default-rtdb.firebaseio.com

# ============================================================
# Database
# ============================================================
DB_TYPE=sqlite
# For large businesses, switch to postgresql:
# DB_TYPE=postgresql
POSTGRES_DSN=postgresql://user:password@localhost:5432/devilerpdb

# SQLite path (auto-created if missing)
SQLITE_PATH=database/devil_erp.db

# ============================================================
# Google Drive Backup
# ============================================================
GDRIVE_CREDENTIALS_FILE=credentials.json
GDRIVE_BACKUP_FOLDER_NAME=DevilERP_Backups

# ============================================================
# AI Model
# ============================================================
AI_MODEL_PATH=models/gemma-2b-it.gguf
AI_MAX_TOKENS=512
AI_TEMPERATURE=0.7
AI_N_CTX=2048

# ============================================================
# App Settings
# ============================================================
APP_LANGUAGE=en
APP_CURRENCY=INR
APP_TIMEZONE=Asia/Kolkata
GST_NUMBER=
COMPANY_NAME=Your Company Name
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
