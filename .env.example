# Devil ERP — Environment Configuration Template
# Developed by Devil One Pvt Ltd & Nexuzy Lab
# Lead Developer: David K. Angel
# Support: nexuzylab@gmail.com | devilonepvtltd@gmail.com
#
# Copy this file to .env and fill in your real values
# Never commit your .env file to git

# ── Firebase Authentication ──────────────────────────────────
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abcdefghij
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# ── Database ─────────────────────────────────────────────────
# Options: sqlite | postgresql
DB_TYPE=sqlite
SQLITE_PATH=database/devilERP.db

# PostgreSQL (only if DB_TYPE=postgresql)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=devilerpdb
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=your_postgres_password

# ── Google Drive Backup ───────────────────────────────────────
GDRIVE_CREDENTIALS_FILE=credentials.json
GDRIVE_BACKUP_FOLDER_NAME=DevilERP_Backups

# ── AI Model ─────────────────────────────────────────────────
AI_MODEL_PATH=models/gemma-2b-it.gguf
AI_MAX_TOKENS=512
AI_TEMPERATURE=0.7
AI_CONTEXT_SIZE=2048

# ── App Settings ─────────────────────────────────────────────
APP_NAME=Devil ERP
APP_LANG=en
CURRENCY_SYMBOL=\u20b9
GST_REGISTERED=true
GSTIN=YOUR_GSTIN_HERE
BUSINESS_NAME=Your Business Name
BUSINESS_ADDRESS=Your Address, City, State - PIN
BUSINESS_PHONE=+91-XXXXXXXXXX
BUSINESS_EMAIL=your@email.com
